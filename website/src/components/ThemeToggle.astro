---
/**
 * A three-way theme control: system, light, dark, as three icon buttons.
 *
 * Replaces Starlight's dropdown, the same as the decoy, assay and catena sites, so the docs
 * and the landing page share one control. State lives in `localStorage` under
 * `starlight-theme` with Starlight's own values (`auto` | `light` | `dark`), so the two stay
 * in agreement and a preference set on one page survives navigating to the other.
 *
 * It can appear twice on a docs page (in the header, and in the phone menu); `group` keeps
 * the two radio groups apart, and the script keeps them in step.
 */
interface Props { group?: string }
const { group = 'lr-theme' } = Astro.props
---

<fieldset class="theme-toggle" data-theme-toggle>
  <legend class="sr-only">Theme</legend>
  <label title="Match system">
    <input type="radio" name={group} value="auto" checked />
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <rect x="1.5" y="2.5" width="13" height="9" rx="1.5" />
      <path d="M5.5 14h5" />
    </svg>
    <span class="sr-only">System</span>
  </label>
  <label title="Light">
    <input type="radio" name={group} value="light" />
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <circle cx="8" cy="8" r="3.1" />
      <path d="M8 .9v1.8M8 13.3v1.8M.9 8h1.8M13.3 8h1.8M3 3l1.3 1.3M11.7 11.7 13 13M13 3l-1.3 1.3M4.3 11.7 3 13" />
    </svg>
    <span class="sr-only">Light</span>
  </label>
  <label title="Dark">
    <input type="radio" name={group} value="dark" />
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <path d="M13.5 9.6A5.8 5.8 0 0 1 6.4 2.5a5.8 5.8 0 1 0 7.1 7.1Z" />
    </svg>
    <span class="sr-only">Dark</span>
  </label>
</fieldset>

<script is:inline>
  ;(() => {
    if (window.__lrThemeToggle) return
    window.__lrThemeToggle = true
    const KEY = 'starlight-theme'
    const media = matchMedia('(prefers-color-scheme: dark)')

    const stored = () => {
      try { const v = localStorage.getItem(KEY); return v === 'light' || v === 'dark' ? v : 'auto' } catch { return 'auto' }
    }
    const apply = (choice) => {
      document.documentElement.dataset.theme = choice === 'auto' ? (media.matches ? 'dark' : 'light') : choice
    }
    const paint = (choice) => {
      for (const input of document.querySelectorAll('[data-theme-toggle] input')) input.checked = input.value === choice
    }
    const set = (choice) => {
      try {
        if (choice === 'auto') localStorage.removeItem(KEY)
        else localStorage.setItem(KEY, choice)
      } catch {}
      // Let colours ease for a moment instead of snapping (see styles/motion.css).
      const root = document.documentElement
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        root.classList.add('lr-theming')
        setTimeout(() => root.classList.remove('lr-theming'), 320)
      }
      apply(choice)
      paint(choice)
    }

    const init = () => {
      const current = stored()
      apply(current)
      paint(current)
      for (const input of document.querySelectorAll('[data-theme-toggle] input')) {
        input.addEventListener('change', () => set(input.value))
      }
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init)
    else init()
    // Following the system while it changes is the point of the `auto` option.
    media.addEventListener('change', () => { if (stored() === 'auto') apply('auto') })
  })()
</script>

<style>
  .theme-toggle {
    display: flex;
    gap: 0;
    margin: 0;
    padding: 2px;
    border: 1px solid var(--lr-line);
    border-radius: 999px;
    background: transparent;
  }
  .theme-toggle label {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.7rem;
    cursor: pointer;
    border-radius: 999px;
    color: var(--lr-muted);
  }
  .theme-toggle input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .theme-toggle svg {
    width: 0.95rem;
    height: 0.95rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .theme-toggle label:hover { color: var(--sl-color-accent); }
  /* The selected segment carries the accent as a fill, so which mode is active reads at a
     glance rather than needing a second look. */
  .theme-toggle label:has(input:checked) {
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
  }
  .theme-toggle label:has(input:focus-visible) {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
