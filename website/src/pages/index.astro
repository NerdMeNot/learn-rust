---
// The landing page: a plain Astro route, outside Starlight's docs shell.
// It reads the same theme choice Starlight stores (`starlight-theme`) and the same
// "coming from" choice the lessons use (`lr:from`), so the two halves agree.
import '../styles/fonts.css'
import '../styles/theme.css'
import '../styles/lesson.css'
import '../styles/home.css'
import '../styles/motion.css'
import RustError from '../components/lesson/RustError.astro'
import CodePanel from '../components/lesson/CodePanel.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import GitHubLink from '../components/GitHubLink.astro'
import { LANG, OTHERS, PARTS, VERDICT } from '../lib/langs'
import index from '../data/lessons.json'
import versions from '../data/versions.json'
import vectors from '../data/lessons/vectors.json'
import ownership from '../data/lessons/ownership.json'

import { getCollection } from 'astro:content'

const learn = index.filter(l => l.part !== 'std' && l.part !== 'further')
const std = index.filter(l => l.part === 'std')
const further = index.filter(l => l.part === 'further')
const docs = await getCollection('docs')
const ORDER: Record<string, string[]> = {
  start: ['why-rust', 'how-rust-thinks', 'first-project', 'using-crates', 'files-and-modules', 'several-programs'],
  build: ['crates-map', 'serde', 'tokio', 'axum', 'grpc', 'sqlx', 'clap', 'app-errors', 'tracing', 'testing', 'datafusion'],
  further: ['project-structure', 'testing-more', 'performance'],
  for: ['go', 'java', 'kotlin', 'csharp', 'python', 'typescript', 'c-cpp'],
  interop: ['python', 'node', 'c-cpp', 'wasm'],
  projects: ['todo', 'money', 'notes-api', 'indexer', 'shop'],
  cheatsheets: ['syntax'],
  checkpoints: ['syntax', 'basics', 'ownership', 'data', 'collections', 'abstractions', 'smart-pointers', 'concurrency', 'std'],
}
const pages = (track: string) => ORDER[track].map(id => docs.find(d => d.id === `${track}/${id}`)).filter(Boolean).map(d => ({ title: d!.data.title, href: `/${d!.id}/` }))
const tour = docs.find(d => d.id === 'std/tour')
const tracks = [
  { name: 'Start here', count: `${ORDER.start.length} pages`, blurb: 'Why Rust is worth it (and what it costs), the mindset, your first project, using libraries, splitting code into files, and running several programs.', items: pages('start') },
  { name: 'Learn Rust', count: `${learn.length} lessons`, blurb: 'The language itself, from variables to ownership, the borrow checker, traits and threads.', items: learn.map(l => ({ title: l.title, href: `/learn/${l.id}/` })) },
  { name: 'Standard library', count: `${std.length + 1} pages`, blurb: 'What comes in the box and how to use it: files, collections, text, processes, formatting, and how to read the docs.', items: [...(tour ? [{ title: tour.data.title, href: '/std/tour/' }] : []), ...std.map(l => ({ title: l.title, href: `/learn/${l.id}/` }))] },
  { name: 'Build with Rust', count: `${ORDER.build.length} pages`, blurb: 'The crates everyone uses: JSON, async, HTTP services, gRPC, databases, CLIs, errors, logging, testing and data.', items: pages('build') },
  { name: 'Going further', count: `${further.length + pages('further').length} pages`, blurb: 'Reading macros, what unsafe is for, idioms and design patterns, project structure, deeper testing, and measuring performance.', items: [...further.map(l => ({ title: l.title, href: `/learn/${l.id}/` })), ...pages('further')] },
  { name: 'Rust for your language', count: `${pages('for').length} pages`, blurb: 'One page per background: the habits to unlearn, an idiom table, the toolchain map and a reading path.', items: pages('for') },
  { name: 'Use Rust from…', count: `${pages('interop').length} pages`, blurb: 'Write the fast or risky part in Rust and call it from Python, Node, C and C++, or WebAssembly.', items: pages('interop') },
  { name: 'Projects', count: `${pages('projects').length} pages`, blurb: 'Complete, tested programs built step by step: a CLI, a library, a web API, a concurrent indexer and a multi-crate workspace.', items: pages('projects') },
  { name: 'Cheat sheets', count: `${pages('cheatsheets').length} page`, blurb: 'One printable page of Rust syntax: symbols, the habits that trip people up, and how to read a signature.', items: pages('cheatsheets') },
  { name: 'Checkpoints', count: `${pages('checkpoints').length} pages`, blurb: 'Predict the output or the compiler error, then run it. One page per part of the course.', items: pages('checkpoints') },
].filter(t => t.items.length > 0)
const anat = vectors.gotcha!
const teaser = ownership.gotcha!
// Each background has one phrasebook; C and C++ share one.
const BOOK: Record<string, { slug: string; title: string }> = {
  go: { slug: 'go', title: 'Go' }, kotlin: { slug: 'kotlin', title: 'Kotlin' }, python: { slug: 'python', title: 'Python' },
  typescript: { slug: 'typescript', title: 'TypeScript' }, java: { slug: 'java', title: 'Java' }, csharp: { slug: 'csharp', title: 'C#' },
  c: { slug: 'c-cpp', title: 'C and C++' }, cpp: { slug: 'c-cpp', title: 'C and C++' },
}
const firstLesson = learn[0].id
const SITE = 'https://learningrust.nerdmenot.in'
const DESC = 'Learn Rust if you already program in Go, Kotlin, Python, TypeScript, Java, C#, C or C++. Each lesson puts a Rust program beside the same one in your language, then shows the real compiler error for the habit that trips you.'
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': SITE + '/#site', url: SITE + '/', name: 'Learn Rust', description: DESC, inLanguage: 'en' },
    { '@type': 'Course', name: 'Learn Rust (even with all your past baggage)', description: DESC, url: SITE + '/', inLanguage: 'en',
      provider: { '@type': 'Organization', name: 'NerdMeNot', url: 'https://github.com/NerdMeNot' }, isAccessibleForFree: true, license: 'https://opensource.org/license/mit' },
  ],
}
const totals = [
  [learn.length + std.length + further.length, 'lessons'],
  [7, 'phrasebooks'], [5, 'projects'], [9, 'checkpoints'], [OTHERS.length, 'languages compared'],
]
const v = versions as Record<string, string>
const ver = (s: string, re: RegExp) => s?.match(re)?.[0] ?? '?'
const toolchains = [
  `rustc ${ver(v.rust, /\d+\.\d+\.\d+/)}`,
  `Go ${ver(v.go, /\d+\.\d+(\.\d+)?/)}`,
  `Kotlin ${ver(v.kotlin, /\d+\.\d+\.\d+/)}`,
  `Java ${ver(v.java, /\d+(\.\d+)*/)}`,
  `Python ${ver(v.python, /\d+\.\d+\.\d+/)}`,
  `TypeScript ${ver(v.typescript, /\d+\.\d+\.\d+/)} on Node ${ver(v.node, /\d+\.\d+\.\d+/)}`,
  `.NET ${ver(v.csharp, /\d+\.\d+\.\d+/)}`,
  `GCC ${ver(v.c, /\d+\.\d+\.\d+/)}`,
]
const boot =
  `try{var t=localStorage.getItem('starlight-theme');document.documentElement.dataset.theme=` +
  `t==='light'||t==='dark'?t:matchMedia('(prefers-color-scheme: light)').matches?'light':'dark';` +
  `var f=localStorage.getItem('lr:from');document.documentElement.dataset.from=${JSON.stringify(OTHERS)}.indexOf(f)>=0?f:'go';` +
  `document.documentElement.dataset.picked=localStorage.getItem('lr:picked')||''}` +
  `catch(e){document.documentElement.dataset.theme='dark';document.documentElement.dataset.from='go'}`
const pickCss = OTHERS.map(k => [
  `:root[data-picked="1"][data-from="${k}"] .choose[data-pick="${k}"]{border-color:var(--c);box-shadow:inset 0 0 0 1px var(--c)}`,
  `:root[data-picked="1"][data-from="${k}"] .choose[data-pick="${k}"]::after{opacity:1;transform:none}`,
  `:root[data-picked="1"][data-from="${k}"] .path[data-for="${k}"]{display:grid}`,
].join('\n')).join('\n') + '\n:root[data-picked="1"] .path-empty{display:none}'
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Learn Rust (even with all your past baggage)</title>
    <meta name="description" content={DESC} />
    <link rel="canonical" href={SITE + '/'} />
    <meta name="theme-color" content="#2a3439" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Learn Rust" />
    <meta property="og:title" content="Learn Rust (even with all your past baggage)" />
    <meta property="og:description" content={DESC} />
    <meta property="og:url" content={SITE + '/'} />
    <meta property="og:image" content={SITE + '/social-card.png'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Learn Rust: a Rust program that will not compile, next to the languages you already know" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Learn Rust (even with all your past baggage)" />
    <meta name="twitter:description" content={DESC} />
    <meta name="twitter:image" content={SITE + '/social-card.png'} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
    <link rel="icon" href="/icon.svg" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/atkinson-hyperlegible-normal-400.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/bricolage-grotesque-normal-600.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/fredoka-normal-600.woff2" crossorigin />
    <script is:inline set:html={boot} />
    <style is:inline set:html={pickCss} />
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/" aria-label="Learn Rust, home"><img src="/icon.svg" alt="" width="30" height="30" /><span class="wordmark">Learn <b>Rust</b></span></a>
      <nav aria-label="Site">
        <a href="/start/how-rust-thinks/">Start here</a>
        <a href={`/learn/${learn[0].id}/`}>Lessons</a>
      </nav>
      <GitHubLink />
      <ThemeToggle group="lr-theme-home" />
    </header>

    <main class="home">
      <section class="hero-grid">
        <div class="hero">
          <p class="eyebrow">Rust for people who already know another language</p>
          <h1>Learn Rust <span>(even with all your past baggage)</span></h1>
          <p>Your code compiles in Go, Java, Python or C++. Rust says no, and it is usually right. Find out what it can see that you can't, and what to write instead.</p>
          <p>Every lesson sets a Rust program beside the same program in your language, then ends with a <strong>gotcha</strong>: code that looks fine, the real compiler error, and the fix.</p>
          <ul class="totals" aria-label="What is on the site">
            {totals.map(([n, label]) => <li><b>{n}</b> {label}</li>)}
          </ul>
          <div class="cta-row">
            <a class="cta" href="#choose-h">Pick your language</a>
            <a class="cta ghost" href="/start/how-rust-thinks/">Or start here</a>
          </div>
          <p class="fine">Every program, output and error on this site comes from a real run: {toolchains.join(', ')}.</p>
        </div>
        <aside class="teaser" aria-labelledby="teaser-h">
          <p class="eyebrow">Try it: this looks fine</p>
          <h2 id="teaser-h">This tiny program won't compile.</h2>
          <CodePanel lang="rust" code={teaser.code} file="src/main.rs" />
          <details class="reveal">
            <summary>Can you see why? Open the compiler's answer</summary>
            <RustError text={teaser.error} code={teaser.error_code} />
            <p class="fine">In Go, <code>b := a</code> shares one array and both names keep working. <a href="/learn/ownership/">Ownership and Moves</a> shows what Rust does instead.</p>
          </details>
        </aside>
      </section>

      <section class="chooser" aria-labelledby="choose-h">
        <h2 id="choose-h">Where are you coming from?</h2>
        <p class="prose">Pick the language you know best. Every comparison on the site shows it first, and your starting path appears right below. Nothing is sent anywhere: the choice is saved in this browser.</p>
        <div class="chooser-grid">
          {OTHERS.map(k => (
            <button class="choose" type="button" data-pick={k} style={`--c:${LANG[k].color}`} aria-pressed="false">
              <b>{LANG[k].name}</b><span>{LANG[k].tagline}</span>
            </button>
          ))}
        </div>
        <div class="path-empty" aria-hidden="true">
          <span>↑</span> Pick a language and your path shows up here.
        </div>
        <div class="path-wrap" aria-live="polite">
          {OTHERS.map(k => (
            <div class="path" data-for={k} style={`--c:${LANG[k].color}`}>
              <p class="eyebrow">Your path · {LANG[k].name}</p>
              <h3>Rust for {BOOK[k].title} developers</h3>
              <p>Starts from what you know ({LANG[k].tagline}), then shows each habit that meets a compiler error, with the fix.</p>
              <div class="cta-row">
                <a class="cta" href={`/for/${BOOK[k].slug}/`}>Read the {BOOK[k].title} phrasebook</a>
                <a class="cta ghost" href={`/learn/${firstLesson}/`}>Start lesson 1</a>
                <a class="cta ghost" href="/cheatsheets/syntax/">Syntax cheat sheet</a>
              </div>
              <p class="fine">Saved on this device. Change it any time from the top of a lesson.</p>
            </div>
          ))}
        </div>
      </section>

      <section class="why" aria-labelledby="why-h">
        <h2 id="why-h">Rust is harder. It is still hard to ignore.</h2>
        <p class="prose">Expect a few months before Rust feels normal. These are the reasons teams pay that price. Every figure comes from the source linked beside it, and <a href="/start/why-rust/">the full case</a> also lists when to skip Rust.</p>
        <div class="why-grid">
          <article class="idea-card">
            <h3>It rules out a class of bug that keeps hurting C and C++</h3>
            <p>Microsoft put memory-safety issues at about 70% of the vulnerabilities it assigns a CVE each year (<a href="https://www.microsoft.com/en-us/msrc/blog/2019/07/a-proactive-approach-to-more-secure-code">MSRC, 2019</a>), and Chrome at about 70% of its high-severity bugs (<a href="https://www.chromium.org/Home/chromium-security/memory-safety/">Chromium</a>). In safe Rust the compiler rules that class out, with no garbage collector.</p>
          </article>
          <article class="idea-card">
            <h3>It has been tried at scale, in public</h3>
            <p>Android's memory-safety share of vulnerabilities fell from 76% in 2019 to 24% in 2024, thanks to memory-safe languages in general, Rust among them (<a href="https://security.googleblog.com/2024/09/eliminating-memory-safety-vulnerabilities-Android.html">Google, 2024</a>). Linux has had Rust support since 6.1, and Cloudflare's Rust proxy uses "about 70% less CPU and 67% less memory" than the system it replaced (<a href="https://blog.cloudflare.com/how-we-built-pingora-the-proxy-that-connects-cloudflare-to-the-internet/">Cloudflare, 2022</a>).</p>
          </article>
          <article class="idea-card">
            <h3>You probably already depend on it</h3>
            <p>uv and Ruff if you write Python. Turbopack, Rolldown, Biome and Deno if you write JavaScript. ripgrep, which has powered search in VS Code since 2017. Tools people wanted much faster were rewritten in Rust while their users kept writing Python or TypeScript.</p>
          </article>
          <article class="idea-card">
            <h3>Governments are asking for plans</h3>
            <p>In December 2023, CISA, NSA, FBI and their counterparts in Australia, Canada, the UK and New Zealand asked software makers to plan how to get memory-safety bugs out of their products (<a href="https://www.cisa.gov/news-events/alerts/2023/12/06/cisa-releases-joint-guide-software-manufacturers-case-memory-safe-roadmaps">CISA</a>). It is guidance, not a ban.</p>
          </article>
        </div>
        <div class="why-cost">
          <h3>And the price, stated plainly</h3>
          <ul>
            <li>In a <a href="https://opensource.googleblog.com/2023/06/rust-fact-vs-fiction-5-insights-from-googles-rust-journey-2022.html">Google survey</a>, a third of respondents said they were as productive in Rust as in their other languages within two months, and over half within four. The rest took longer.</li>
            <li>Slow compilation tops the productivity problems in the <a href="https://blog.rust-lang.org/2026/03/02/2025-State-Of-Rust-Survey-results">2025 State of Rust survey</a>.</li>
            <li>It is the wrong tool for some jobs: quick scripts, and ports where another language fits the existing code better.</li>
          </ul>
          <p><a class="cta ghost" href="/start/why-rust/">Read the sourced case for and against →</a></p>
        </div>
      </section>

      <section class="vibe" aria-labelledby="vibe-h">
        <h2 id="vibe-h">Vibe-coding Rust works, right up until it doesn't</h2>
        <p class="prose">Ask an assistant for Rust, paste the compiler's complaints back, repeat until it builds. That gets a program that compiles. These are the places where it stops being enough, and the hours that fix it are the ones on this site.</p>
        <div class="why-grid">
          <article class="idea-card">
            <h3>The compiler asks questions only you can answer</h3>
            <p>Rust rejects code whose ownership it can't follow, and the way out depends on what the code is for. The error shown <a href="#anat-h">further down</a> offers two fixes: borrow the value, or clone it. Choosing between them takes knowing who should own the data. <a href="/errors/">Reading compiler errors</a> is the place to start.</p>
          </article>
          <article class="idea-card">
            <h3>Compiling is not the same as correct</h3>
            <p>Safe Rust rules out memory bugs, not wrong logic. In November 2025 a Cloudflare proxy called <code>unwrap()</code> on an error it hadn't handled, panicked, and took much of their network down (<a href="https://blog.cloudflare.com/18-november-2025-outage/">Cloudflare</a>). The compiler let it through because it was valid. Rust makes you decide what happens on an error, and only you can make that decision a good one.</p>
          </article>
          <article class="idea-card">
            <h3>Some code the compiler can't vouch for</h3>
            <p>Inside an <code>unsafe</code> block, the promises move from the compiler to whoever wrote the block. The first security bug in the Linux kernel's Rust code was a data race inside an <code>unsafe</code> block (<a href="https://www.cve.org/CVERecord?id=CVE-2025-68260">CVE-2025-68260</a>). If you can't read a <code>// SAFETY:</code> comment and judge it, you can't review it. <a href="/learn/unsafe/"><code>unsafe</code>, honestly</a> covers how.</p>
          </article>
          <article class="idea-card">
            <h3>The quickest way to silence an error is often the wrong one</h3>
            <p><code>.clone()</code> to quiet the borrow checker, <code>unwrap</code> in a library, <code>Rc&lt;RefCell&lt;_&gt;&gt;</code> for everything: all three compile, and the <a href="/learn/idioms/#habits-that-look-like-idioms">Idioms lesson</a> shows what each costs. <a href="/learn/borrow-checker/">Working with the Borrow Checker</a> shows the fixes that change the design instead.</p>
          </article>
        </div>
        <div class="why-cost">
          <h3>An assistant doesn't change who reviews the code</h3>
          <p>Use one if you like. You still read what comes back, run it, and answer for it. Learning Rust is an investment, and the numbers are public: in a Google survey, a third of respondents were as productive as in their other languages within two months, and over half within four (<a href="https://opensource.googleblog.com/2023/06/rust-fact-vs-fiction-5-insights-from-googles-rust-journey-2022.html">Google, 2023</a>). The rest took longer.</p>
          <p class="cta-row">
            <a class="cta" href="/learn/rust-at-a-glance/">Start with the syntax</a>
            <a class="cta ghost" href="/errors/">Learn to read the errors</a>
          </p>
        </div>
      </section>

      <section class="tracks" aria-label="Tracks">
        {tracks.map(t => (
          <div class="track-card">
            <span class="eyebrow">{t.count}</span>
            <h3><a href={t.items[0].href}>{t.name}</a></h3>
            <p>{t.blurb}</p>
            <ul>
              {t.items.slice(0, 6).map(x => <li><a href={x.href}>{x.title}</a></li>)}
              {t.items.length > 6 && <li class="more"><a href={t.items[0].href}>and {t.items.length - 6} more</a></li>}
            </ul>
          </div>
        ))}
      </section>

      <section class="idea" aria-labelledby="idea-h">
        <h2 id="idea-h">The one idea behind every gotcha</h2>
        <div class="idea-card">
          <span class="chip" style="--c:var(--lr-muted)">Most languages</span>
          <q>Is this code wrong?</q>
          <p>If nothing is clearly broken, it compiles. Whatever could go wrong is dealt with while the program runs: by a garbage collector, a null pointer exception, a crash, or a race detector if you remember to use it.</p>
        </div>
        <div class="idea-card">
          <span class="chip" style="--c:var(--lr-rust)">Rust</span>
          <q>Can I prove this can never go wrong?</q>
          <p>If it can't prove it, it refuses, even when your program would actually work. There's no garbage collector to clean up afterwards, so it has to be sure before the program runs.</p>
        </div>
        <div class="idea-foot">
          <h3>Why harmless-looking code fails</h3>
          <ul>
            <li>The compiler <strong>doesn't run your code</strong>. It doesn't know what is in your variables, whether a key exists, or which thread finishes first.</li>
            <li>It only sees the <strong>shape</strong> of the code: the types, and the order things happen in.</li>
            <li>So when your code has the same shape as code that would crash, it says no. It isn't saying your code is wrong. It is saying it can't prove your code is right.</li>
          </ul>
        </div>
      </section>

      <section aria-labelledby="real-h" class="stack">
        <h2 id="real-h">Is real-world Rust this hard?</h2>
        <p class="prose">No. The gotchas show the edges on purpose, so you recognise them. Everyday Rust reads a lot like the code you already write.</p>
        <div class="real">
          <div class="idea-card">
            <h3>What you will write most days</h3>
            <ul>
              <li>Structs that <strong>own</strong> their data: <code>String</code>, <code>Vec</code>, <code>Arc&lt;T&gt;</code>. No lifetimes to write.</li>
              <li>Functions that borrow to read (<code>&amp;T</code>) and <strong>return new values</strong>.</li>
              <li>Changes through <code>&amp;mut self</code> methods like <code>push</code> and <code>insert</code>, about as often as you'd call a method that changes an object anywhere else.</li>
              <li>Iterator chains for loops, and <code>?</code> for errors.</li>
            </ul>
          </div>
          <div class="idea-card">
            <h3>What you mostly read, not write</h3>
            <ul>
              <li>Hand-written lifetimes (<code>'a</code>), <code>&amp;&amp;T</code>, <code>&amp;mut &amp;T</code>.</li>
              <li>They live in parsers, zero-copy decoders, and the insides of libraries like Arrow, Parquet and Tantivy, so that your side stays simple.</li>
              <li>If your code starts to feel like pointer gymnastics, there is almost always a version that returns a value instead. Write that one.</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="legend" aria-labelledby="legend-h">
        <h2 id="legend-h">Four kinds of gotcha</h2>
        <p class="prose">Every gotcha carries one of these labels, so you know whether you are learning a safety rule or just a different habit.</p>
        <div class="legend-grid">
          {Object.entries(VERDICT).map(([k, x]) => (
            <div class="legend-item" style={`--vc:var(--lr-v-${k});--vb:var(--lr-v-${k}-bg)`}>
              <span class="badge">{x.label}</span>
              <p>{x.text}</p>
            </div>
          ))}
        </div>
      </section>

      <section aria-labelledby="anat-h" class="stack">
        <h2 id="anat-h">How to read a compiler error</h2>
        <p class="prose">Rust's errors look long, but they follow a fixed layout. This is the real error from the gotcha in lesson {vectors.order}, {vectors.title}.</p>
        <div class="anatomy">
          <RustError text={anat.error} code={anat.error_code} />
          <ol>
            <li>The <span class="k" style="color:var(--lr-term-err)">error[{anat.error_code}]</span> line names the rule that was broken. Look up the code with <code>rustc --explain {anat.error_code}</code>.</li>
            <li><span class="k" style="color:var(--lr-term-dim)">--&gt;</span> gives the file, line and column.</li>
            <li>The <span class="k" style="color:var(--lr-term-hint)">-</span> marks are the other parts of the story: here, where the borrow started and where it is used later.</li>
            <li>The <span class="k" style="color:var(--lr-term-mark)">^</span> marks where the compiler gave up. Read the marked lines in order, top to bottom.</li>
            <li><span class="k" style="color:var(--lr-term-hint)">help:</span> is a suggestion. It is often right. When it suggests <code>.clone()</code>, check first, because there is usually a fix that copies nothing.</li>
          </ol>
        </div>
      </section>

      <section class="index" aria-labelledby="idx-h">
        <h2 id="idx-h">Every lesson</h2>
        <ol class="steps">
          <li>Read the Rust program, then the same program in your language below it.</li>
          <li>At the gotcha, look at the Rust code and guess what's wrong before you read the error.</li>
          <li>Copy the fixed version into your editor, then break it again on purpose.</li>
        </ol>
        {[...PARTS].map(p => {
          const list = index.filter(l => l.part === p.id)
          return (
            <div class="index-part">
              <h3>{p.label}</h3>
              <div class="index-list">
                {list.map(l => (
                  <a href={`/learn/${l.id}/`}>
                    <span class="num">{l.order}</span><span class="t">{l.title}</span>
                    {l.verdict ? <span class="dot" style={`--vc:var(--lr-v-${l.verdict})`} title={`Gotcha: ${VERDICT[l.verdict as keyof typeof VERDICT].short}`} /> : <span />}
                  </a>
                ))}
              </div>
            </div>
          )
        })}
        <p class="fine">{learn.length} lessons, {std.length} standard library pages and {further.length} more in Going further.</p>
      </section>
    </main>

    <footer class="site-foot">
      <p>Learn Rust is an independent project. It is not affiliated with the Rust Project or the Rust Foundation. The Rust name and logo are trademarks of the Rust Foundation; the claw mark here is ours.</p>
