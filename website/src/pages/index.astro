---
// The landing page: a plain Astro route, outside Starlight's docs shell.
// It reads the same theme choice Starlight stores (`starlight-theme`) and the same
// "coming from" choice the lessons use (`lr:from`), so the two halves agree.
//
// Order of the page: what this is and who it is for (with the language choice), the path in
// order, every lesson, what else there is, then the short "is it worth it" and "how to read a
// gotcha" explanations. The long case for and against lives on /start/why-rust/.
import Analytics from '../components/Analytics.astro'
import '../styles/fonts.css'
import '../styles/theme.css'
import '../styles/lesson.css'
import '../styles/home.css'
import '../styles/motion.css'
import RustError from '../components/lesson/RustError.astro'
import CodePanel from '../components/lesson/CodePanel.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import GitHubLink from '../components/GitHubLink.astro'
import { LANG, OTHERS, PARTS, PHRASEBOOK, VERDICT } from '../lib/langs'
import { START } from '../lib/path'
import index from '../data/lessons.json'
import versions from '../data/versions.json'
import ownership from '../data/lessons/ownership.json'

import { getCollection } from 'astro:content'

const std = index.filter(l => l.part === 'std')
const further = index.filter(l => l.part === 'further')
const docs = await getCollection('docs')
const ORDER: Record<string, string[]> = {
  build: ['crates-map', 'serde', 'tokio', 'rayon', 'rayon-tokio', 'axum', 'grpc', 'sqlx', 'clap', 'app-errors', 'tracing', 'testing', 'datafusion'],
  further: ['project-structure', 'testing-more', 'performance'],
  for: ['go', 'java', 'kotlin', 'csharp', 'python', 'typescript', 'c-cpp'],
  interop: ['python', 'node', 'c-cpp', 'wasm'],
  projects: ['todo', 'money', 'notes-api', 'indexer', 'shop'],
  cheatsheets: ['syntax'],
  checkpoints: ['syntax', 'basics', 'ownership', 'data', 'collections', 'abstractions', 'smart-pointers', 'concurrency', 'std'],
}
const doc = (id: string) => docs.find(d => d.id === id)
const link = (id: string) => ({ title: doc(id)!.data.title, href: `/${id}/` })
const pages = (track: string) => ORDER[track].map(id => doc(`${track}/${id}`)).filter(Boolean).map(d => ({ title: d!.data.title, href: `/${d!.id}/` }))

// The path: the three pages the sidebar opens with, then lesson 1.
const firstLesson = index[0]
const path = [
  ...START.map(s => ({ title: link(s.href.replace(/^\/|\/$/g, '')).title, href: s.href, note: s.note })),
  { title: `Lesson 1: ${firstLesson.title}`, href: `/learn/${firstLesson.id}/`, note: 'Then the lessons in order, each with a gotcha. The sidebar ticks off what you have read.' },
]

// Pages that belong to a part of the lesson index but are not lessons, in the sidebar's places.
const extras: Record<string, { first?: { title: string; href: string }[]; last?: { title: string; href: string }[] }> = {
  data: { last: [link('start/word-frequency')] },
  std: { first: [link('std/tour')] },
  further: { last: pages('further') },
}

// What there is besides the lessons. (The lessons themselves are the index above.)
const tracks = [
  { name: 'Build with Rust', blurb: 'The crates everyone uses: JSON, async, HTTP services, gRPC, databases, CLIs, errors, logging, testing and data.', items: pages('build') },
  { name: 'Projects', blurb: 'Complete, tested programs built step by step: a CLI, a library, a web API, a concurrent indexer and a multi-crate workspace.', items: pages('projects') },
  { name: 'Rust for your language', blurb: 'One page per background: the habits to unlearn, an idiom table, the toolchain map and a reading path.', items: pages('for') },
  { name: 'Use Rust from…', blurb: 'Write the fast or risky part in Rust and call it from Python, Node, C and C++, or WebAssembly.', items: pages('interop') },
  { name: 'Checkpoints', blurb: 'Predict the output or the compiler error, then run it. One page per part of the course.', items: pages('checkpoints') },
  { name: 'Cheat sheets', blurb: 'One printable page of Rust syntax: symbols, the habits that trip people up, and how to read a signature.', items: pages('cheatsheets') },
].filter(t => t.items.length > 0)
const teaser = ownership.gotcha!
const SITE = 'https://learningrust.nerdmenot.in'
const DESC = 'Learn Rust if you already program in Go, Kotlin, Python, TypeScript, Java, C#, C or C++. Each lesson puts a Rust program beside the same one in your language, then shows the real compiler error for the habit that trips you.'
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': SITE + '/#site', url: SITE + '/', name: 'Learn Rust', description: DESC, inLanguage: 'en' },
    { '@type': 'Course', name: 'Learn Rust (even with all your past baggage)', description: DESC, url: SITE + '/', inLanguage: 'en',
      provider: { '@type': 'Organization', name: 'NerdMeNot', url: 'https://github.com/NerdMeNot' }, isAccessibleForFree: true, license: 'https://opensource.org/license/mit' },
  ],
}
const v = versions as Record<string, string>
const ver = (s: string, re: RegExp) => s?.match(re)?.[0] ?? '?'
const toolchains = [
  `rustc ${ver(v.rust, /\d+\.\d+\.\d+/)}`,
  `Go ${ver(v.go, /\d+\.\d+(\.\d+)?/)}`,
  `Kotlin ${ver(v.kotlin, /\d+\.\d+\.\d+/)}`,
  `Java ${ver(v.java, /\d+(\.\d+)*/)}`,
  `Python ${ver(v.python, /\d+\.\d+\.\d+/)}`,
  `TypeScript ${ver(v.typescript, /\d+\.\d+\.\d+/)} on Node ${ver(v.node, /\d+\.\d+\.\d+/)}`,
  `.NET ${ver(v.csharp, /\d+\.\d+\.\d+/)}`,
  `GCC ${ver(v.c, /\d+\.\d+\.\d+/)}`,
]
const boot =
  `try{var t=localStorage.getItem('starlight-theme');document.documentElement.dataset.theme=` +
  `t==='light'||t==='dark'?t:matchMedia('(prefers-color-scheme: light)').matches?'light':'dark';` +
  `var f=localStorage.getItem('lr:from');document.documentElement.dataset.from=${JSON.stringify(OTHERS)}.indexOf(f)>=0?f:'go';` +
  `document.documentElement.dataset.picked=localStorage.getItem('lr:picked')||''}` +
  `catch(e){document.documentElement.dataset.theme='dark';document.documentElement.dataset.from='go'}`
// Which pill looks chosen, and which note shows, before any script runs (no flash).
const pickCss = OTHERS.map(k => [
  `:root[data-picked="1"][data-from="${k}"] .pill[data-pick="${k}"]{border-color:var(--c);box-shadow:inset 0 0 0 1px var(--c);background:var(--lr-soft)}`,
  `:root[data-picked="1"][data-from="${k}"] .from-picked[data-for="${k}"]{display:block}`,
].join('\n')).join('\n') + '\n:root[data-picked="1"] .from-empty{display:none}'
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Learn Rust (even with all your past baggage)</title>
    <meta name="description" content={DESC} />
    <link rel="canonical" href={SITE + '/'} />
    <meta name="theme-color" content="#2a3439" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Learn Rust" />
    <meta property="og:title" content="Learn Rust (even with all your past baggage)" />
    <meta property="og:description" content={DESC} />
    <meta property="og:url" content={SITE + '/'} />
    <meta property="og:image" content={SITE + '/social-card.png'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Learn Rust: a Rust program that will not compile, next to the languages you already know" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Learn Rust (even with all your past baggage)" />
    <meta name="twitter:description" content={DESC} />
    <meta name="twitter:image" content={SITE + '/social-card.png'} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
    <link rel="icon" href="/icon.svg" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/atkinson-hyperlegible-normal-400.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/bricolage-grotesque-normal-600.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/fredoka-normal-600.woff2" crossorigin />
    <script is:inline set:html={boot} />
    <style is:inline set:html={pickCss} />
    <Analytics />
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/" aria-label="Learn Rust, home"><img src="/icon.svg" alt="" width="30" height="30" /><span class="wordmark">Learn <b>Rust</b></span></a>
      <nav aria-label="Site">
        <a href={START[0].href}>Start here</a>
        <a href="#lessons">Lessons</a>
      </nav>
      <GitHubLink />
      <ThemeToggle group="lr-theme-home" />
    </header>

    <main class="home">
      <section class="hero-grid">
        <div class="hero">
          <p class="eyebrow">Rust for people who already know another language</p>
          <h1>Learn Rust <span>(even with all your past baggage)</span></h1>
          <p>Your code works in Go, Java, Python or C++. Rust says no, and it is usually right. Every lesson sets a Rust program beside the same one in your language, then shows a <strong>gotcha</strong>: code that looks fine, the real compiler error, and the fix.</p>
          <div class="from" role="group" aria-labelledby="from-h">
            <h2 id="from-h">Which language do you know best?</h2>
            <div class="pills">
              {OTHERS.map(k => (
                <button class="pill" type="button" data-pick={k} style={`--c:${LANG[k].color}`} title={LANG[k].tagline} aria-pressed="false">{LANG[k].name}</button>
              ))}
            </div>
            <div class="from-note" aria-live="polite">
              <p class="from-empty fine">Every comparison on the site starts with it. Saved in this browser only; nothing is sent anywhere.</p>
              {OTHERS.map(k => (
                <p class="from-picked" data-for={k}>Comparisons now start with <b>{LANG[k].name}</b>. <a href={`/for/${PHRASEBOOK[k].slug}/`}>Read Rust for {PHRASEBOOK[k].title} developers →</a></p>
              ))}
            </div>
          </div>
          <div class="cta-row">
            <a class="cta" href={START[0].href}>Start the course</a>
            <a class="cta ghost" href="#lessons">Browse all {index.length} lessons</a>
          </div>
        </div>
        <aside class="teaser" aria-labelledby="teaser-h">
          <p class="eyebrow">Try it: this looks fine</p>
          <h2 id="teaser-h">This tiny program won't compile.</h2>
          <CodePanel lang="rust" code={teaser.code} file="src/main.rs" />
          <details class="reveal">
            <summary>Can you see why? Open the compiler's answer</summary>
            <RustError text={teaser.error} code={teaser.error_code} />
            <p class="fine">In Go, <code>b := a</code> shares one array and both names keep working. <a href="/learn/ownership/">Ownership and Moves</a> shows what Rust does instead. <a href="/errors/">Reading compiler errors</a> explains how to read the message.</p>
          </details>
        </aside>
      </section>

      <section class="start" aria-labelledby="start-h">
        <h2 id="start-h">Where to start, in order</h2>
        <ol class="path-steps">
          {path.map((s, i) => (
            <li>
              <span class="n" aria-hidden="true">{i + 1}</span>
              <a href={s.href}>{s.title}</a>
              <p>{s.note}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="index" id="lessons" aria-labelledby="idx-h">
        <h2 id="idx-h">Every lesson</h2>
        <p class="prose">{index.length} lessons, in the order the sidebar shows them. The coloured dot says what kind of gotcha a lesson ends on (<a href="#gotcha-kinds">what the dots mean</a>). Read the Rust program, then the same program in your language; at the gotcha, guess what is wrong before you open the error.</p>
        {[...PARTS].map(p => {
          const list = index.filter(l => l.part === p.id)
          const ex = extras[p.id] ?? {}
          return (
            <div class="index-part">
              <h3>{p.label}</h3>
              <div class="index-list">
                {(ex.first ?? []).map(x => <a class="extra" href={x.href}><span class="num" aria-hidden="true">▸</span><span class="t">{x.title}</span><span /></a>)}
                {list.map(l => (
                  <a href={`/learn/${l.id}/`}>
                    <span class="num">{l.order}</span><span class="t">{l.title}</span>
                    {l.verdict ? <span class="dot" style={`--vc:var(--lr-v-${l.verdict})`} title={`Gotcha: ${VERDICT[l.verdict as keyof typeof VERDICT].short}`} /> : <span />}
                  </a>
                ))}
                {(ex.last ?? []).map(x => <a class="extra" href={x.href}><span class="num" aria-hidden="true">▸</span><span class="t">{x.title}</span><span /></a>)}
              </div>
            </div>
          )
        })}
        <p class="fine">A ▸ marks a guide or project that sits among the lessons.</p>
      </section>

      <section class="tracks-wrap" aria-labelledby="more-h">
        <h2 id="more-h">Beyond the lessons</h2>
        <div class="tracks">
          {tracks.map(t => (
            <div class="track-card">
              <span class="eyebrow">{t.items.length} {t.items.length === 1 ? 'page' : 'pages'}</span>
              <h3><a href={t.items[0].href}>{t.name}</a></h3>
              <p>{t.blurb}</p>
              <ul>
                {t.items.slice(0, 5).map(x => <li><a href={x.href}>{x.title}</a></li>)}
                {t.items.length > 5 && <li class="more"><a href={t.items[0].href}>and {t.items.length - 5} more</a></li>}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section class="why" aria-labelledby="why-h">
        <h2 id="why-h">Is it worth the effort?</h2>
        <div class="why-grid">
          <article class="idea-card">
            <h3>Rust is harder. It is still hard to ignore.</h3>
            <p>Memory-safety bugs are about 70% of the vulnerabilities Microsoft assigns a CVE each year (<a href="https://www.microsoft.com/en-us/msrc/blog/2019/07/a-proactive-approach-to-more-secure-code">MSRC, 2019</a>) and of Chrome's high-severity bugs (<a href="https://www.chromium.org/Home/chromium-security/memory-safety/">Chromium</a>). In safe Rust the compiler rules that class out, with no garbage collector. The price: in a <a href="https://opensource.googleblog.com/2023/06/rust-fact-vs-fiction-5-insights-from-googles-rust-journey-2022.html">Google survey</a>, a third of respondents were as productive in Rust as in their other languages within two months, and over half within four. The rest took longer.</p>
            <p><a href="/start/why-rust/">Read the sourced case for and against →</a></p>
          </article>
          <article class="idea-card">
            <h3>Using an AI assistant to write it?</h3>
            <p>Pasting the compiler's complaints back until it builds gets you a program that compiles. It stops being enough where the compiler asks who should own the data, where code is valid but wrong, inside <code>unsafe</code>, and when the quickest way to silence an error is the wrong one.</p>
            <p><a href="/start/why-rust/#when-an-assistant-writes-your-rust">Where an assistant stops being enough →</a></p>
          </article>
        </div>
      </section>

      <section class="idea" aria-labelledby="idea-h">
        <h2 id="idea-h">The one idea behind every gotcha</h2>
        <div class="idea-card">
          <span class="chip" style="--c:var(--lr-muted)">Most languages</span>
          <q>Is this code wrong?</q>
          <p>If nothing is clearly broken, it compiles. Whatever could go wrong is dealt with while the program runs: by a garbage collector, a null pointer exception, a crash, or a race detector if you remember to use it.</p>
        </div>
        <div class="idea-card">
          <span class="chip" style="--c:var(--lr-rust)">Rust</span>
          <q>Can I prove this can never go wrong?</q>
          <p>If it can't prove it, it refuses, even when your program would actually work. There's no garbage collector to clean up afterwards, so it has to be sure before the program runs.</p>
        </div>
        <div class="idea-foot">
          <h3>Why harmless-looking code fails</h3>
          <ul>
            <li>The compiler <strong>doesn't run your code</strong>. It doesn't know what is in your variables, whether a key exists, or which thread finishes first.</li>
            <li>It only sees the <strong>shape</strong> of the code: the types, and the order things happen in.</li>
            <li>So when your code has the same shape as code that would crash, it says no. It isn't saying your code is wrong. It is saying it can't prove your code is right.</li>
          </ul>
        </div>
      </section>

      <section aria-labelledby="real-h" class="stack">
        <h2 id="real-h">Is real-world Rust this hard?</h2>
        <p class="prose">No. The gotchas show the edges on purpose, so you recognise them. Everyday Rust reads a lot like the code you already write.</p>
        <div class="real">
          <div class="idea-card">
            <h3>What you will write most days</h3>
            <ul>
              <li>Structs that <strong>own</strong> their data: <code>String</code>, <code>Vec</code>, <code>Arc&lt;T&gt;</code>. No lifetimes to write.</li>
              <li>Functions that borrow to read (<code>&amp;T</code>) and <strong>return new values</strong>.</li>
              <li>Changes through <code>&amp;mut self</code> methods like <code>push</code> and <code>insert</code>, about as often as you'd call a method that changes an object anywhere else.</li>
              <li>Iterator chains for loops, and <code>?</code> for errors.</li>
            </ul>
          </div>
          <div class="idea-card">
            <h3>What you mostly read, not write</h3>
            <ul>
              <li>Hand-written lifetimes (<code>'a</code>), <code>&amp;&amp;T</code>, <code>&amp;mut &amp;T</code>.</li>
              <li>They live in parsers, zero-copy decoders, and the insides of libraries like Arrow, Parquet and Tantivy, so that your side stays simple.</li>
              <li>If your code starts to feel like pointer gymnastics, there is almost always a version that returns a value instead. Write that one.</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="legend" id="gotcha-kinds" aria-labelledby="legend-h">
        <h2 id="legend-h">Four kinds of gotcha</h2>
        <p class="prose">Every gotcha carries one of these labels, so you know whether you are learning a safety rule or just a different habit. To read the compiler's message itself, see <a href="/errors/">Reading compiler errors</a>.</p>
        <div class="legend-grid">
          {Object.entries(VERDICT).map(([k, x]) => (
            <div class="legend-item" style={`--vc:var(--lr-v-${k});--vb:var(--lr-v-${k}-bg)`}>
              <span class="badge">{x.label}</span>
              <p>{x.text}</p>
            </div>
          ))}
        </div>
      </section>
    </main>

    <footer class="site-foot">
      <p>Every program, output and error on this site comes from a real run: {toolchains.join(', ')}.</p>
      <p>Learn Rust is an independent project. It is not affiliated with the Rust Project or the Rust Foundation. The Rust name and logo are trademarks of the Rust Foundation; the claw mark here is ours.</p>
      <p>Code and text under the <a href="https://github.com/NerdMeNot/learn-rust/blob/main/LICENSE">MIT licence</a> · <a href="https://github.com/NerdMeNot/learn-rust">Source on GitHub</a></p>
    </footer>

    <script>
      const root = document.documentElement
      const sync = () => document.querySelectorAll<HTMLElement>('[data-pick]').forEach(b =>
        b.setAttribute('aria-pressed', String(root.dataset.picked === '1' && root.dataset.from === b.dataset.pick)))
      sync()
      document.addEventListener('click', e => {
        const b = (e.target as Element).closest<HTMLElement>('[data-pick]')
        if (!b) return
        root.dataset.from = b.dataset.pick
        root.dataset.picked = '1'
        try { localStorage.setItem('lr:from', b.dataset.pick!); localStorage.setItem('lr:picked', '1') } catch {}
        sync()
        // Show what the click did: the note under the pills fades in.
        root.classList.add('lr-switching')
        setTimeout(() => root.classList.remove('lr-switching'), 500)
      })
    </script>
  </body>
</html>
