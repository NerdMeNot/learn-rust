    </footer>

    <script>
      const root = document.documentElement
      const sync = () => document.querySelectorAll<HTMLElement>('[data-pick]').forEach(b =>
        b.setAttribute('aria-pressed', String(root.dataset.picked === '1' && root.dataset.from === b.dataset.pick)))
      sync()
      document.addEventListener('click', e => {
        const b = (e.target as Element).closest<HTMLElement>('[data-pick]')
        if (!b) return
        const first = root.dataset.picked !== '1'
        root.dataset.from = b.dataset.pick
        root.dataset.picked = '1'
        try { localStorage.setItem('lr:from', b.dataset.pick!); localStorage.setItem('lr:picked', '1') } catch {}
        sync()
        // Show what the click did: fade the path in, and bring it into view if it is below the fold.
        root.classList.add('lr-switching')
        setTimeout(() => root.classList.remove('lr-switching'), 500)
        const path = document.querySelector<HTMLElement>(`.path[data-for="${b.dataset.pick}"]`)
        if (path && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          const r = path.getBoundingClientRect()
          if (first || r.bottom > innerHeight) path.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
        }
      })
    </script>
  </body>
</html>
